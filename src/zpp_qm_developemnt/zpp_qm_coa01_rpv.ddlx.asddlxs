@Metadata.layer: #CUSTOMER
@UI: {
  headerInfo: { typeName: 'NABL COA Form',
                typeNamePlural: 'COA Document Header',
                title: { type: #STANDARD, label: 'NABL COA Form', value: 'Ulrnum' } },
  presentationVariant: [{ sortOrder: [{ by: 'Inspection', direction:  #DESC }] }] }

annotate entity ZPP_QM_COA01_RPV with
{
  @UI.facet: [ { id:              'Header',
                      purpose:         #STANDARD,
                      type:            #IDENTIFICATION_REFERENCE,
                      label:           'COA Document Header',
                      position:        10 },
                      { id:              'Items',
                      purpose:         #STANDARD,
                      type:            #LINEITEM_REFERENCE,
                      label:           'COA Document Item',
                      position:        20,
                      targetElement:   '_Item'}] 

  @UI: {  lineItem:       [ { position: 10, label: 'Inspection' } ],
        identification:   [ { position: 10, label: 'Inspection' } ,
          { type: #FOR_ACTION, dataAction: 'Print_View' , label: 'PDF View' ,position: 10 }], 
        selectionField: [{ position: 10 }]}
@EndUserText.label: 'Inspection Lot'                                                   
Inspection;
  @UI: {  lineItem:       [ { position: 20, label: 'URL Number' } ],
        identification:   [ { position: 20, label: 'URL Number' } ]}                     
Ulrnum;
  @UI: {  lineItem:       [ { position: 30, label: 'Report IssueOn' } ],
        identification:   [ { position: 30, label: 'Report IssueOn' } ]}                     
Reportissueon;
  @UI: {  lineItem:       [ { position: 40, label: 'Product' } ],
        identification:   [ { position: 40, label: 'Product' } ]} 
@EndUserText.label: 'Product'     
@Consumption.valueHelpDefinition: [{ entity:{ name: 'zpp_qm_productvh',element: 'Product' } 
                                        ,additionalBinding: [{ localElement: 'Productdesc',
                                        element: 'ProductName' }]}]   
