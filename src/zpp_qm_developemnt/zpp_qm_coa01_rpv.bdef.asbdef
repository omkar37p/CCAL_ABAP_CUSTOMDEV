projection;
strict ( 2 );
use draft;

define behavior for ZPP_QM_COA01_RPV //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use action Resume;
  use action Edit;
  use action Activate;
  use action Discard;
  use action Prepare;

  use action Print_View;

  use association _Item { create; with draft;}
}

define behavior for ZPP_QM_COA01_IPV //alias <alias_name>
{
  use update;
  use delete;

  use association _Header { with draft; }
}