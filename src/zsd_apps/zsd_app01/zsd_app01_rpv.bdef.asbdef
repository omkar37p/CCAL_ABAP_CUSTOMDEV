projection;
strict ( 2 );
use draft;

define behavior for ZSD_APP01_RPV //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use action GetTare;
  use action GetGross;
  use action Pack;
  use action PostGI;

  use action Resume;
  use action Edit;
  use action Activate;
  use action Discard;
  use action Prepare;

  use association _Item { with draft; }
}

define behavior for ZSD_APP01_IPV1 //alias <alias_name>
{
  use update;
  use delete;

  use association _Header { with draft; }
}