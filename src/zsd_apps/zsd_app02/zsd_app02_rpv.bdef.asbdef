projection;
strict ( 1 );
use draft;
use side effects;

define behavior for ZSD_APP02_RPV //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use action GetTare;
  use action GetTareUrl;

  use action Resume;
  use action Edit;
  use action Activate;
  use action Discard;
  use action Prepare;

  use association _Item { with draft; }
}

define behavior for ZSD_APP02_IPV //alias <alias_name>
{
  use update;
  use delete;

  use action GetGross;
  use action GetGrossUrl;

  use association _Header { with draft; }
}