@Metadata.layer: #PARTNER
@UI:{
headerInfo: { typeName: ' Inventory Ageing Report',
              typeNamePlural: ' Inventory Ageing Report',
              title : { type: #STANDARD, label: ' Inventory Ageing Report', value: 'mat'}
            },
            presentationVariant: [{ sortOrder: [{ by: 'mat', direction:  #DESC }] }]

     }
annotate view ZMM_INVENTORY_AG_PV_NEW
    with 
{
    @UI.facet: [{  purpose: #STANDARD ,
               type: #IDENTIFICATION_REFERENCE,
               position: 10,
               label: 'Inventory Ageing Report'}]
               
    @UI: { lineItem: [{ position: 40,label: 'Material' }],
  identification: [{ position: 40,label: 'Material' }],
  selectionField  : [{position: 10}]}
