@Metadata.layer: #CUSTOMER
@UI: {
  headerInfo: { typeName: 'Purchase Key Register Report',
                typeNamePlural: 'Purchase Key Report',
                title: { type: #STANDARD, label: 'Purchase Key Reports', value: 'PurchaseOrder' } } }
//  presentationVariant: [{ sortOrder: [{ by: 'PurchaseOrder', direction:  #ASC }] }] }
