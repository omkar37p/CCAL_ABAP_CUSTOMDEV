@Metadata.layer: #PARTNER
@UI: {
  headerInfo: { typeName: 'Stock Age Bucket - Multiple Materials',
                typeNamePlural: 'Inventoty Ageing Report',
                title: { type: #STANDARD, label: 'Inventoty Ageing Report-MultipleMaterial', value: 'Product' } },
  presentationVariant: [{ sortOrder: [{ by: 'SDDocument', direction:  #ASC }] }] }
annotate entity ZMM_INVENTORY_AGING_PV
    with 
{

  @UI.facet: [ {    id:              'Material',
                    purpose:         #STANDARD,
                    type:            #IDENTIFICATION_REFERENCE,
