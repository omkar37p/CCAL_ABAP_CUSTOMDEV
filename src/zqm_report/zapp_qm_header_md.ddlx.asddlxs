@Metadata.layer: #CUSTOMER
@UI: { headerInfo: {
typeName: 'QM Inspection',
typeNamePlural: 'QM Inspection Report',
title: { type: #STANDARD, value: 'InspectionLot' },
         description: { type: #STANDARD, value: 'ProductDescription' }
         } }

annotate entity ZAPP_QM_HEADER
    with 
{
  @UI.facet: [ { id:              'Header',
                      purpose:         #STANDARD,
//                      type:            #IDENTIFICATION_REFERENCE,
                      label:           'QM Basic Information',
                      position:        10 }
//                    { id:              'Items',
//                      purpose:         #STANDARD,
//                      type:            #LINEITEM_REFERENCE,
//                      label:           'QM Inspection Result',
//                      position:        20,
//                      targetElement:   '_Qmitem'}
                      ]
                      
  @UI: { lineItem: [{ position: 10, label: 'InspectionLot Number'}],
    selectionField: [{ position: 10 }]}
    @Consumption.valueHelpDefinition: [{ entity: { name: 'I_InspectionLotStdVH',
                                                   element: 'InspectionLot' } }]    
  @EndUserText.label: 'InspectionLot'    
InspectionLot;
  @UI: { lineItem: [{ position: 20, label: 'Material Code'}],
    selectionField: [{ position: 20 }]}
    @Consumption.valueHelpDefinition: [{ entity: { name: 'I_ProductDescription',
                                                   element: 'Product' } }]    
  @EndUserText.label: 'Material Code'        
Material;
  @UI: { lineItem: [{ position: 30, label: 'Material Description'}] }
  @EndUserText.label: 'Material Description'        
ProductDescription;

  @UI: { lineItem: [{ position: 40, label: 'Master IC'}] }
  @EndUserText.label: 'Master IC'      
InspectionSpecification;
  @UI: { lineItem: [{ position: 44, label: 'Specification Minimum' } ] }
  @EndUserText.label: 'Specification Minimum'      
InspSpecLowerLimit;
  @UI: { lineItem: [{ position: 46, label: 'Specification Maximum' } ] }
  @EndUserText.label: 'Specification Maximum'      
InspSpecUpperLimit;
@UI.hidden: true
Specification;
  @UI: { lineItem: [{ position: 50, label: 'Parameter'}] }
//      @Consumption.valueHelpDefinition: [{ entity: { name: 'I_InspSpecificationVersionText',
//                                                   element: 'InspectionSpecificationText' } }]    
  @EndUserText.label: 'Parameter'      
InspectionCharacteristicText;
  @UI: { lineItem: [{ position: 55, label: 'Result Attribute'}] }
  @EndUserText.label: 'Result Attribute'      
Notmorethen;
  @UI: { lineItem: [{ position: 60, label: 'Result Value'}] }
  @EndUserText.label: 'Result Value'      
InResult;
  @UI: { lineItem: [{ position: 70, label: 'Code Des'}] }
  @EndUserText.label: 'Code Des'      
CharacteristicAttributeCode;
  @UI: { lineItem: [{ position: 80, label: 'Accept/Rejected'}] }
  @EndUserText.label: 'Accept/Rejected'      
Status;
  @UI: { lineItem: [{ position: 90, label: 'Inspection Description'}] }
  @EndUserText.label: 'Inspection Description'      
InspectionDescription;
  @UI: { lineItem: [{ position: 100, label: 'Result Date'}] }
      @Consumption.filter:{ selectionType: #INTERVAL,multipleSelections: false } 
  @EndUserText.label: 'Result Date'
InspectionLotStartDate1;
  @UI: { lineItem: [{ position: 110, label: 'Result Time'}] }
  @EndUserText.label: 'Result Time'      
InspectionEndTime;
  @UI: { lineItem: [{ position: 120, label: 'Result Created By'}] }
  @EndUserText.label: 'Result Created By'             
ResultCreatedBy;

  @UI: { lineItem: [{ position: 130, label: 'Plant'}],
    selectionField: [{ position: 30 }]}
    @Consumption.valueHelpDefinition: [{ entity: { name: 'I_PlantStdVH',
                                                   element: 'Plant' } }]    
  @EndUserText.label: 'Plant'        
Plant;
  @UI: { lineItem: [{ position: 140, label: 'Inspection  Type'}] }
  @EndUserText.label: 'Inspection  Type'        
InspectionLotType;
  @UI: { lineItem: [{ position: 150, label: 'Lot Quantity'}] }
  @EndUserText.label: 'Lot Quantity'        
InspectionLotQuantity;
  @UI: { lineItem: [{ position: 160, label: 'Vehicle Number'}] }
  @EndUserText.label: 'Vehicle Number'        
Truckno;
  @UI: { lineItem: [{ position: 170, label: 'Creation Date'}],
    selectionField: [{ position: 40 }] }
    @Consumption.filter:{ selectionType: #INTERVAL,multipleSelections: false } 
@EndUserText.label: 'Creation Date'    
InspectionLotCreatedOn;
//  @UI: { identification: [{ position: 90, label: 'Created By' } ] }
//PersonFullName;
  @UI: { lineItem: [{ position: 180, label: 'Inspection Lot Text'}] }
  @EndUserText.label: 'Inspection Lot Text'        
InspectionLotText;
  @UI: { lineItem: [{ position: 190, label: 'Supplier Name' } ] }
  @EndUserText.label: 'Supplier Name'      
BPSupplierFullName;
  @UI: { lineItem: [{ position: 200, label: 'Batch' } ],
  selectionField: [{ position: 50 }] }
      @Consumption.valueHelpDefinition: [{ entity: { name: 'I_BatchStdVH',
                                                   element: 'Batch' } }]    
  @EndUserText.label: 'Batch'     
Batch;
  @UI: { lineItem: [{ position: 210, label: 'Inspection lot start date' } ] }
    @Consumption.filter:{ selectionType: #INTERVAL,multipleSelections: false }   
  @EndUserText.label: 'Inspection lot start date'      
InspectionLotStartDate;
  @UI: { lineItem: [{ position: 220, label: 'Inspection Operation Desc' } ] }
  @EndUserText.label: 'Inspection Operation Desc'      
OperationText;
@UI.hidden: true
CreationDate;
@UI.hidden: true
PersonFullName;
@UI.hidden: true
InspectionLotQuantityUnit;
@UI.hidden: true
MaterialDocument;
@UI.hidden: true
MaterialDocumentItem;
@UI.hidden: true
MaterialDocumentYear;
}