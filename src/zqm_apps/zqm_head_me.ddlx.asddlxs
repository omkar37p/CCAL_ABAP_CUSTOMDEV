@Metadata.layer: #CUSTOMER
@UI: {
  headerInfo: { typeName: 'NABL COA Form',
                typeNamePlural: 'NABL COA Application',
                title: { type: #STANDARD, label: 'NABL COA Form', value: 'Ulrnum' } },
  presentationVariant: [{ sortOrder: [{ by: 'Inspection', direction:  #DESC }] }] }

annotate entity ZQM_HEAD_PV
    with 
{
  @UI.facet: [ { id:              'Header',
                      purpose:         #STANDARD,
                      type:            #IDENTIFICATION_REFERENCE,
                      label:           'NABL COA Header',
                      position:        10 },
                      { id:              'Items',
                      purpose:         #STANDARD,
                      type:            #LINEITEM_REFERENCE,
                      label:           'NABL COA Item',
                      position:        20,
                      targetElement:   '_Item'}] 

  @UI: {  lineItem:       [ { position: 10, label: 'Inspection' } ],
        identification:   [ { position: 10, label: 'Inspection' } ,
          { type: #FOR_ACTION, dataAction: 'Print_View' , label: 'NABL COA Print' ,position: 10 },
          { type: #FOR_ACTION, dataAction: 'Label_View' , label: 'Label Print', position: 20 } ],
        selectionField: [{ position: 10 }]}
    @Consumption.valueHelpDefinition: [{ entity: { name: 'ZINSPECTION_VH', element: 'InspectionLot' },
                                                            additionalBinding: [{ localElement: 'Product',
                                                            element: 'Product' }] }]                        
@EndUserText.label: 'Inspection Lot'                                                   
Inspection;
  @UI: {  lineItem:       [ { position: 20, label: 'ULR Number' } ],
        identification:   [ { position: 20, label: 'ULR Number' } ]}
        @EndUserText.label: 'ULR Number'                     
Ulrnum;
  @UI: {  lineItem:       [ { position: 30, label: 'Report Issued On' } ],
        identification:   [ { position: 30, label: 'Report Issued On' } ],
        selectionField: [{ position: 30 }]}
    @Consumption.filter:{ selectionType: #INTERVAL,multipleSelections: false }
    @EndUserText.label: 'Report Issued On'                                                     
Reportissueon;
  @UI: {  lineItem:       [ { position: 40, label: 'Product' } ],
        identification:   [ { position: 40, label: 'Product' } ] } 
@EndUserText.label: 'Product'     
@Consumption.valueHelpDefinition: [{ entity:{ name: 'I_ProductText',element: 'Product' } }]   
Product;
@UI: { lineItem: [{ position: 50, label: 'Sample Identity'  }],
         identification: [{ position: 50, label: 'Sample Identity' }] }
         @EndUserText.label: 'Sample Identity'
Productdesc;
@UI: { identification: [{ position: 60, label: 'Discipline' }] }
@EndUserText.label: 'Discipline'
Discipline;
  @UI: {  lineItem:       [ { position: 60, label: 'Customer' } ],
        identification:   [ { position: 70, label: 'Customer' } ]}
  @Consumption.valueHelpDefinition: [{ entity:{ name: 'ZQM_CUSTOMER_VH',element: 'Customer' } 
                                        ,additionalBinding: [{ localElement: 'Issuedto',
                                        element: 'BPCustomerFullName' }]}]         
        @EndUserText.label: 'Customer'                            
Customer;
@UI: { identification: [{ position: 80, label: 'COA Group' }] }
@Consumption.valueHelpDefinition: [{ entity: { name: 'ZQM_GROUPDES_VH', element: 'text' }, 
                                    distinctValues: true }] //this one for Dropdown option
@EndUserText.label: 'COA Group'                                    
Coagroup;
@UI: { lineItem: [{ position: 70, label: 'Customer Name' }], 
     identification: [{ position: 90, label: 'Customer Name' }] }
     @EndUserText.label: 'Customer Name'
Issuedto;
@UI: { identification: [{ position: 100, label: 'TruckNo' }] }
@EndUserText.label: 'TruckNo'
Truckno;
@UI: { identification: [{ position: 110, label: 'Customer Address' }] }
@EndUserText.label: 'Customer Address'
Partyaddress;
@UI: { identification: [{ position: 120, label: 'Reference' }] }
@EndUserText.label: 'Reference'
Reference;
@UI: { identification: [{ position: 130, label: 'Report Number' }] }
@EndUserText.label: 'Report Number'
Reportno;
@UI: { identification: [{ position: 140, label: 'Batch' }] }
@EndUserText.label: 'Batch'
Batch;
@UI: { identification: [{ position: 150, label: 'Manufacturing Date' }] }
    @Consumption.filter:{ selectionType: #INTERVAL,multipleSelections: false }
    @EndUserText.label: 'Manufacturing Date'                        
Mfgdate;
@UI: { identification: [{ position: 160, label: 'Sample Receipt' }] }
    @Consumption.filter:{ selectionType: #INTERVAL,multipleSelections: false }
    @EndUserText.label: 'Sample Receipt'                        
Samplereceipt;
@UI: { identification: [{ position: 170, label: 'Date of Analysis' }] }
    @Consumption.filter:{ selectionType: #INTERVAL,multipleSelections: false } 
    @EndUserText.label: 'Date of Analysis'                       
Dateofanalyis;
@UI: { identification: [{ position: 180, label: 'Description' }] }
@EndUserText.label: 'Description'
Description;
  @UI: {  lineItem:       [ { position: 80, label: 'Plant' } ],
        identification:   [ { position: 190, label: 'Plant' } ],
        selectionField: [{ position: 20 }]}
    @Consumption.valueHelpDefinition: [{ entity: { name: 'I_PlantStdVH',
                                                   element: 'Plant' } }]                
@EndUserText.label: 'Plant'        
Plant; 
@UI: { identification: [{ position: 200, label: 'COA Format' }] }
@Consumption.valueHelpDefinition: [{ entity: { name: 'ZQM_COAFORMAT_VH', element: 'text' }, 
                                    distinctValues: true }] //this one for Dropdown option
@EndUserText.label: 'COA Format'
Nablformat;
@UI: { identification: [{ position: 210, label: 'Terms & condition' }] }
@Consumption.valueHelpDefinition: [{ entity: { name: 'ZQM_TERMSC_VH', element: 'text' }, 
                                    distinctValues: true }] //this one for Dropdown option
@EndUserText.label: 'Terms & condition'
Termscond;
@UI: { identification: [{ position: 220, label: 'Driver Name' }] }
@EndUserText.label: 'Driver Name'
Driver;
@UI: { identification: [{ position: 230, label: 'Conc' }] }
@EndUserText.label: 'Conc'
Conc;
  @UI: {  lineItem:       [ { position: 90, label: 'COA PDF Output' } ],
        identification:   [ { position: 240, label: 'COA PDF Output' } ] }              
@EndUserText.label: 'COA PDF Output'    
Coaattachment;
  @UI: {  lineItem:       [ { position: 100, label: 'Label PDF Output' } ],
        identification:   [ { position: 250, label: 'Label PDF Output' } ] }           
@EndUserText.label: 'Label PDF Output'    
Lapattachment;
@UI.hidden: true
Coafilename;
@UI.hidden: true
Coamimetype;
@UI.hidden: true
Lapfilename;
@UI.hidden: true
Lapmimetype;
@UI.hidden: true
Uuid;
@UI.hidden: true
Serialno;
@UI.hidden: true
Status;
@UI.hidden: true
Itmcnt;
@UI.hidden: true
Mark;
@UI.hidden: true
Createdat;
@UI.hidden: true
Createdby;
@UI.hidden: true
Lastchangedat;
@UI.hidden: true
Lastchangedby;

/* Associations */
@UI.hidden: true
_Item;    
}