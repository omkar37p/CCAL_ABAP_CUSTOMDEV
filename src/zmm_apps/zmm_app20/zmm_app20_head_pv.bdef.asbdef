projection;
strict ( 1 );
use draft;
use side effects;
define behavior for ZMM_APP20_HEAD_PV //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use action GetPDF;

  use action Resume;
  use action Edit;
  use action Activate;
  use action Discard;
  use action Prepare;

  use association _Item { create; with draft; }
}

define behavior for ZMM_APP20_ITEM_PV //alias <alias_name>
{
  use update;
  use delete;

  use association _Header { with draft; }
}