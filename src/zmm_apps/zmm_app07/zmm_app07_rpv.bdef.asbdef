projection;
strict ( 2 );
use draft;
use side effects;

define behavior for ZMM_APP07_RPV //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use action CrtPr;

  use action Resume;
  use action Edit;
  use action Activate;
  use action Discard;
  use action Prepare;

  use association _Item { create; with draft; }
}

define behavior for ZMM_APP07_IPV1 //alias <alias_name>
{
  use update;
  use delete;

  use association _Header { with draft; }
}