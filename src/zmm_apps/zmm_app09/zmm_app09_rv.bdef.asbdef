managed implementation in class zbp_mm_app09_rv unique;
strict ( 2 );
with draft;


define behavior for ZMM_APP09_RV alias BDGCODE
//persistent table zmm_app09_tb1
with unmanaged save
//early numbering
draft table zmm_app09_dt3
lock master
total etag Createdat
authorization master ( instance )
etag master Createdat
{
  create;
  update;
  delete;
  draft action ( features : instance ) Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;

  field ( readonly, numbering : managed ) Uuid;
  field ( mandatory : create ) Plant, Deptid;
  field ( readonly : update ) Plant, Deptid;
  field ( readonly ) Createdat, Createdby, Validon, Validto, Basebdg, Curky, Talcbdg, Bdgcode, Delemrk;
  field ( mandatory ) Bdgtype;


  association _Item { create; with draft; }

  determination CrtData on save { create; update; field Bdgtype; }

  validation mandt on save { create; field Bdgtype; }

  mapping for zmm_app09_tb1 corresponding;

}

define behavior for ZMM_APP09_IV1 alias BDGITM
//persistent table zmm_app09_tb2
with unmanaged save
draft table zmm_app09_dt4
lock dependent by _Header
authorization dependent by _Header
//etag master <field_name>
{
  update;
  delete;
  field ( readonly ) Plant, Deptid, Uuid, Bdgcode, Itemno;
  field ( readonly : update ) Allcbdg, Bdgitxt, Remarks, Curky;

  association _Header { with draft; }

  determination CrtItem on save { create; field Allcbdg; }
  side effects
  { field Allcbdg affects field _Header.Talcbdg; }

  determination UpdItem on save { field Actstss, Allcbdg, Bdgitxt, Remarks; }

  validation Totval on save { field Allcbdg; }
  validation Totval2 on save { create; field Allcbdg; }

  mapping for zmm_app09_tb2 corresponding;

}