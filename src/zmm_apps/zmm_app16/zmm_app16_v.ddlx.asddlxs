@Metadata.layer: #CUSTOMER
annotate entity zmm_app16_V
    with 
{
  @UI.facet: [ { id:              'Item',
                   purpose:         #STANDARD,
                   type:            #IDENTIFICATION_REFERENCE,
                   label:           'Standard Items',
                   position:        10 } ]
  @UI.hidden: true
  Uuid;
