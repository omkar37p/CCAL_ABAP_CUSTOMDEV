projection;
strict ( 2 );
use draft;

define behavior for ZMM_APP01_RPV //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _bdgitm { create; with draft; }
}

define behavior for ZMM_APP01_IPV1 //alias <alias_name>
{
  use update;
  use delete;

  use association _bdghdr { with draft; }
}