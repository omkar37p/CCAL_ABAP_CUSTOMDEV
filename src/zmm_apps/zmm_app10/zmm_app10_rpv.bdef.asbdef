projection;
strict ( 1 );
use draft;

define behavior for ZMM_APP10_RPV //alias <alias_name>
{
  use create;
  use update;
  use delete;

  //  use action GetGross;

  use action Resume;
  use action Edit;
  use action Activate;
  use action Discard;
  use action Prepare;

  use association _Item { create; with draft; }
  use association _Gout { create; with draft; }
}

