  @UI: {
  lineItem: [{ position: 40, label: 'Purchase Order Type' }],
  identification: [{ position: 40, label: 'Purchase Order Type' }] }
  @EndUserText.label: 'Purchase Order Type'
  PurchaseOrderType;
  @UI: {
  lineItem: [{ position: 50, label: 'Purchase Order Date' }],
  identification: [{ position: 50, label: 'Purchase Order Date' }] }
  @EndUserText.label: 'Purchase Order Date'
  PurchaseOrderDate;
  @UI:{ lineItem: [{ position: 60, label: 'Supplier' }],
