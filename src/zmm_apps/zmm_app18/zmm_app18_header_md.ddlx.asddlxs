@Metadata.layer: #CUSTOMER
@UI: { headerInfo: {
typeName: 'Tax Document',
typeNamePlural: 'Purchase Order',
title: { type: #STANDARD, value: 'Purchasekey' },
         description:{ value: 'PurchaseOrder' }
         } }
annotate entity ZMM_APP18_RPV with
{
  @UI.facet: [{
      id: 'Header',
      purpose: #STANDARD,
      position: 10,
      label: 'Purchase Header',
      type: #IDENTIFICATION_REFERENCE
  },
  {
  id: 'Items',
      purpose: #STANDARD,
      position: 20,
      label: 'Purchase Item',
      type: #LINEITEM_REFERENCE,
      targetElement: '_Item'
  },
   { id: 'PurchaseStatus',
     purpose: #HEADER,
     type: #DATAPOINT_REFERENCE,
     position: 10,
     targetQualifier: 'POStatus'
     },
    { id: 'User',
      purpose: #HEADER,
      type: #DATAPOINT_REFERENCE,
      position: 20,
      targetQualifier: 'UserId'
     }]
  @UI: {
  lineItem: [{ position: 10, label: 'Company Code' }],
  identification: [{ position: 10, label: 'Company Code' },
  { type: #FOR_ACTION, dataAction: 'Document', label: 'Submit Document'  }]}
  @Consumption.valueHelpDefinition: [{
      entity: { name: 'I_CompanyCodeStdVH',
                element: 'CompanyCode'}}]
  @UI.selectionField: [{ position: 10 , element: 'CompanyCode'}]
  @Consumption.filter: { mandatory: true,multipleSelections: false}
  @EndUserText.label: 'Company Code'
  CompanyCode;
  @UI: {
  lineItem: [{ position: 20, label: 'Purchase Order' }],
  identification: [{ position: 20, label: 'Purchase Order' }] }
  @Consumption.valueHelpDefinition: [{
      entity: { name: 'ZMM_POVH1',
                element: 'PurchaseOrder'}}]
  @UI.selectionField: [{ position: 20 , element: 'PurchaseOrder'}]
