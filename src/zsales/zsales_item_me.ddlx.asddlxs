@Metadata.layer: #CUSTOMER
@UI: { headerInfo: {
typeName: 'Sales Item',
typeNamePlural: 'Sales Item',
title: { type: #STANDARD, value: 'SalesDocumentItem' } } }
@UI.createHidden: true
@UI.deleteHidden: true
@UI.updateHidden: true
annotate entity ZSALES_ITEM_C
    with 
{
  @UI.facet: [ { id:              'Item',
                   purpose:         #STANDARD,
                   type:            #IDENTIFICATION_REFERENCE,
                   label:           'Standard Item',
                   position:        10 } ]
                   
@UI:{ lineItem: [{ position: 10, label: 'SalesDocument' }],
        identification: [{ position: 10, label: 'SalesDocument' }] } 
@EndUserText.label: 'SalesDocument' 
SalesDocument;
@UI:{ lineItem: [{ position: 20, label: 'SalesDocumentItem' }],
        identification: [{ position: 20, label: 'SalesDocumentItem' }] } 
@EndUserText.label: 'SalesDocumentItem' 
SalesDocumentItem;
@UI:{ lineItem: [{ position: 30, label: 'Material' }],
        identification: [{ position: 30, label: 'Material' }] } 
@EndUserText.label: 'Material' 
Material;
@UI:{ lineItem: [{ position: 40, label: 'SalesDocumentItemText' }],
        identification: [{ position: 40, label: 'SalesDocumentItemText' }] } 
@EndUserText.label: 'SalesDocumentItemText' 
SalesDocumentItemText;
@UI:{ lineItem: [{ position: 50, label: 'Plant' }],
        identification: [{ position: 50, label: 'Plant' }] } 
@EndUserText.label: 'Plant' 
Plant;
@UI:{ lineItem: [{ position: 60, label: 'BaseUnit' }],
        identification: [{ position: 60, label: 'BaseUnit' }] } 
@EndUserText.label: 'BaseUnit' 
BaseUnit;
@UI:{ lineItem: [{ position: 70, label: 'OrderQuantity' }],
        identification: [{ position: 70, label: 'OrderQuantity' }] } 
@EndUserText.label: 'OrderQuantity' 
OrderQuantity;
@UI.hidden: true
/* Associations */
_header;
    
}